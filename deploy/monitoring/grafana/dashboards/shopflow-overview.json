{
  "annotations": {"list": []},
  "editable": true,
  "graphTooltip": 0,
  "title": "ShopFlow Overview",
  "uid": "shopflow-overview",
  "timezone": "",
  "schemaVersion": 39,
  "version": 1,
  "time": {"from": "now-30m", "to": "now"},
  "refresh": "10s",
  "templating": {
    "list": [
      {
        "name": "service",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "query": "label_values(up, service)",
        "includeAll": true,
        "multi": true,
        "current": {"text": "All", "value": "$__all"}
      }
    ]
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "HTTP request rate (req/s)",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "sum by (service) (rate(http_server_requests_seconds_count{service=~\"$service\"}[1m]))", "legendFormat": "{{service}}"}
      ]
    },
    {
      "type": "timeseries",
      "title": "HTTP error rate (5xx, req/s)",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "sum by (service) (rate(http_server_requests_seconds_count{service=~\"$service\", status=~\"5..\"}[1m]))", "legendFormat": "{{service}}"}
      ]
    },
    {
      "type": "timeseries",
      "title": "HTTP average latency (s)",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "sum by (service) (rate(http_server_requests_seconds_sum{service=~\"$service\"}[1m])) / sum by (service) (rate(http_server_requests_seconds_count{service=~\"$service\"}[1m]))", "legendFormat": "{{service}}"}
      ]
    },
    {
      "type": "timeseries",
      "title": "JVM heap used (bytes)",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "sum by (service) (jvm_memory_used_bytes{service=~\"$service\", area=\"heap\"})", "legendFormat": "{{service}}"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Kafka consumer lag (records)",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "sum by (service, client_id) (kafka_consumer_fetch_manager_records_lag{service=~\"$service\"})", "legendFormat": "{{service}} {{client_id}}"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Product cache hit vs miss (per min)",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "sum by (result) (rate(shopflow_product_cache_total[1m])) * 60", "legendFormat": "{{result}}"}
      ]
    }
  ]
}
