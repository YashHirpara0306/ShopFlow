# ShopFlow local configuration.
# Copy to `.env` (which is git-ignored) and adjust. Never commit real secrets.

# --- PostgreSQL ---
POSTGRES_USER=shopflow
POSTGRES_PASSWORD=shopflow
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- JWT (used from Phase 4 / Phase 14) ---
# Generate a real one with:  openssl rand -base64 48
JWT_SECRET=dev-only-change-me-0123456789abcdef0123456789abcdef0123456789
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# --- Payment simulator (Phase 9) ---
PAYMENT_FAIL_RATE=0.15

# --- Inter-service URLs used by the gateway when run outside Docker ---
USER_SERVICE_URI=http://localhost:8081
PRODUCT_SERVICE_URI=http://localhost:8082
CART_SERVICE_URI=http://localhost:8083
ORDER_SERVICE_URI=http://localhost:8084
